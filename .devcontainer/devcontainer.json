{
  "name": "SIX Skincare",

  // The image Codespaces uses by default. Deliberately not a slimmer
  // Node-specific image: those define their own user (usually `node`), which
  // collides with the `codespace` user Codespaces expects and fails container
  // creation with "cannot create directory '/home/codespace'".
  //
  // For the same reason there is no "remoteUser" key here. Do not add one.
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",

  // Runs once when the Codespace is created, so the first thing you type is
  // `npm run dev`.
  "postCreateCommand": "npm install",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SIX storefront",
      "onAutoForward": "openBrowserOnce"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["bradlc.vscode-tailwindcss"]
    }
  }
}
