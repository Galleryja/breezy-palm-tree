# Stripe secret key. Test keys start with sk_test_, live keys with sk_live_.
# Get one at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# Public base URL, used to build Stripe's success/cancel redirect URLs.
#
# Leave this UNSET in development. The checkout route falls back to the
# request's own origin, which is correct both on localhost and behind a
# Codespaces forwarded URL. Hard-coding localhost here is the usual way to
# break checkout in a Codespace: Stripe would send shoppers back to a
# localhost address their browser cannot reach.
#
# Set it only in production, to the real origin, with no trailing slash.
# NEXT_PUBLIC_SITE_URL=https://sixskincare.com
